# Copy to .env.local and fill in. Values here are baked into the build (they are public).

# Formspree form endpoint for the Contact Us enquiry form.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id

# Endpoint for the careers application form. Must accept file uploads (multipart/form-data),
# e.g. a Formspree form on a plan that supports file uploads.
VITE_CAREERS_ENDPOINT=https://formspree.io/f/your-careers-form-id
